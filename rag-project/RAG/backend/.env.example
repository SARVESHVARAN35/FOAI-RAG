APP_NAME="Enterprise IT Incident Knowledge RAG Assistant"
APP_ENV=development
DEBUG=true

# PostgreSQL connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/FOAI

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Generate a private key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used from Phase 3/4 onward
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
VECTOR_STORE_DIR=vector_store
